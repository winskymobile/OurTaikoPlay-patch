diff --git a/Assets/OurTaiko/Runtime/Core/InGameFont.cs b/Assets/OurTaiko/Runtime/Core/InGameFont.cs
new file mode 100644
index 0000000..907322e
--- /dev/null
+++ b/Assets/OurTaiko/Runtime/Core/InGameFont.cs
@@ -0,0 +1,159 @@
+using System.Collections.Generic;
+using System.IO;
+using TMPro;
+using UnityEngine;
+using UnityEngine.TextCore.LowLevel;
+
+namespace OurTaiko
+{
+    // Simplified and Traditional Chinese use the same lettering as the Japanese UI:
+    // FOT-OedKtr Std E (Assets/OurTaiko/Art/大江户勘亭流.otf), embedded by the patch build.
+    // A font asset carries one material, so swapping only TMP's font drops the outline the game
+    // paints through "Nijiiro UI SDF Outline". Every text therefore keeps its original material
+    // style: the style is cloned once against the new atlas, and the font and material are
+    // restored together when the language leaves Simplified/Traditional.
+    sealed class InGameFont : MonoBehaviour
+    {
+        const string ResourceName = "OurTaiko.Art.OedKtrStdE.otf";
+        const string CacheFile = "OedKtrStdE.otf";
+        static InGameFont driver;
+        static TMP_FontAsset asset;
+        static bool failed;
+        static string language;
+        static readonly Dictionary<TMP_Text, TMP_FontAsset> Originals = new Dictionary<TMP_Text, TMP_FontAsset>();
+        static readonly Dictionary<Material, Material> Clones = new Dictionary<Material, Material>();
+        static readonly Dictionary<Material, Material> Sources = new Dictionary<Material, Material>();
+        float nextScan;
+
+        public static TMP_FontAsset Asset => asset;
+
+        // Called from ApplyInGame and from the screens that build text every frame.
+        public static void Use(TMP_Text text)
+        {
+            if (text == null) return;
+            string current = UiText.InGameLanguage(UiText.Language);
+            if (current != "zh" && current != "zh_tw") { Restore(text); return; }
+            var wanted = Load();
+            if (wanted == null) { Restore(text); return; }
+            Swap(text, wanted);
+        }
+
+        public static void Use(Transform root)
+        {
+            if (root == null) return;
+            foreach (var text in root.GetComponentsInChildren<TMP_Text>(true)) Use(text);
+        }
+
+        public static void EnsureDriver()
+        {
+            if (driver != null) return;
+            var go = new GameObject("InGameFont");
+            driver = go.AddComponent<InGameFont>();
+            DontDestroyOnLoad(go);
+        }
+
+        // Text built after a screen's first paint (pooled cards, search rows) picks the font up here.
+        void Update()
+        {
+            if (Time.unscaledTime < nextScan) return;
+            nextScan = Time.unscaledTime + 0.5f;
+            string current = UiText.InGameLanguage(UiText.Language);
+            if (current != "zh" && current != "zh_tw")
+            {
+                if (language != current) { language = current; RestoreAll(); }
+                return;
+            }
+            language = current;
+            var wanted = Load();
+            if (wanted == null) return;
+            foreach (var canvas in Object.FindObjectsOfType<Canvas>())
+                foreach (var text in canvas.GetComponentsInChildren<TMP_Text>(true)) Swap(text, wanted);
+        }
+
+        static void Swap(TMP_Text text, TMP_FontAsset font)
+        {
+            if (text == null) return;
+            if (!Originals.ContainsKey(text)) Originals[text] = text.font;
+            var material = Map(text.fontSharedMaterial, font);
+            if (text.font != font) text.font = font;
+            if (text.fontSharedMaterial != material) text.fontSharedMaterial = material;
+        }
+
+        static void Restore(TMP_Text text)
+        {
+            if (text == null) return;
+            if (text.fontSharedMaterial != null && Sources.TryGetValue(text.fontSharedMaterial, out var source))
+                text.fontSharedMaterial = source;
+            if (Originals.TryGetValue(text, out var font) && text.font != font) text.font = font;
+        }
+
+        static void RestoreAll()
+        {
+            foreach (var canvas in Object.FindObjectsOfType<Canvas>())
+                foreach (var text in canvas.GetComponentsInChildren<TMP_Text>(true)) Restore(text);
+            Originals.Clear();
+        }
+
+        // One clone per distinct shared material (plain text, outlined text, title plates, …).
+        // The clone keeps that material's outline, face dilation and colours; only the atlas and
+        // its sampling parameters move to the new font asset. Screens that restyle a text after
+        // it was swapped (fresh material) are cloned from that material instead of a stale one.
+        static Material Map(Material current, TMP_FontAsset font)
+        {
+            if (current == null) return font.material;
+            var original = Sources.TryGetValue(current, out var source) ? source : current;
+            if (Clones.TryGetValue(original, out var mapped)) return mapped;
+            mapped = new Material(original)
+            {
+                name = original.name + " (OedKtr)",
+                shaderKeywords = original.shaderKeywords
+            };
+            mapped.SetTexture(ShaderUtilities.ID_MainTex, font.atlasTexture);
+            mapped.SetFloat(ShaderUtilities.ID_TextureWidth, font.atlasWidth);
+            mapped.SetFloat(ShaderUtilities.ID_TextureHeight, font.atlasHeight);
+            mapped.SetFloat(ShaderUtilities.ID_GradientScale, font.atlasPadding + 1);
+            Clones[original] = mapped;
+            Sources[mapped] = original;
+            return mapped;
+        }
+
+        static TMP_FontAsset Load()
+        {
+            if (asset != null || failed) return asset;
+            try
+            {
+                string path = Extract();
+                if (path == null) { failed = true; return null; }
+                // 64 pt and 32 px padding are Nijiiro UI SDF's own settings, so the outline keeps
+                // exactly its width. One 6144 atlas holds the whole translation table plus room
+                // for song titles that are added while browsing.
+                asset = TMP_FontAsset.CreateFontAsset(path, 0, 64, 32, GlyphRenderMode.SDFAA, 6144, 6144);
+                if (asset == null) { failed = true; return null; }
+                asset.atlasPopulationMode = AtlasPopulationMode.Dynamic;
+                asset.isMultiAtlasTexturesEnabled = true;
+                if (!asset.TryAddCharacters(UiText.InGameCharacters(), out string missing, false))
+                    Debug.LogWarning("in-game font is missing: " + missing);
+                return asset;
+            }
+            catch (System.Exception error)
+            {
+                Debug.LogWarning("in-game font unavailable: " + error.Message);
+                failed = true;
+                return null;
+            }
+        }
+
+        static string Extract()
+        {
+            string dir = Path.Combine(Application.persistentDataPath, "cache");
+            string path = Path.Combine(dir, CacheFile);
+            Directory.CreateDirectory(dir);
+            using var stream = typeof(InGameFont).Assembly.GetManifestResourceStream(ResourceName);
+            if (stream == null) return null;
+            if (File.Exists(path) && new FileInfo(path).Length == stream.Length) return path;
+            using var target = File.Create(path);
+            stream.CopyTo(target);
+            return path;
+        }
+    }
+}
