+
+        public static string InGameLanguage(string language) =>
+            language == "ja" || language == "zh" || language == "zh_tw" ? language : "ja";
+
+        // Every character the in-game table can show in Simplified or Traditional Chinese, so the
+        // patched font asset can bake them up front instead of growing its atlas during play.
+        public static string InGameCharacters()
+        {
+            var seen = new HashSet<char>();
+            foreach (var row in Table.Values)
+                foreach (char c in row[1] + row[2]) seen.Add(c);
+            foreach (char c in "0123456789★☆（）()・：:！!？?…—-/ ") seen.Add(c);
+            var chars = new char[seen.Count];
+            seen.CopyTo(chars);
+            return new string(chars);
+        }
+
+        public static string Settings(string source) => Settings(source, CurrentLanguage());
+
+        // Settings text with placeholders, e.g. "{0}P signed out.".
+        public static string SettingsFormat(string source, params object[] args) =>
+            string.Format(Settings(source), args);
+        public static string InGame(string source) => InGame(source, CurrentLanguage());
+
+        public static string Settings(string source, string language)
+        {
+            if (string.IsNullOrEmpty(source) || language == "en") return source;
+            return Find(source, language) ?? source;
+        }
+
+        public static string InGame(string source, string language)
+        {
+            if (string.IsNullOrEmpty(source)) return source;
+            string shown = InGameLanguage(language);
+            if (shown == "ja") return Find(source, "ja") ?? source;
+            return Find(source, shown) ?? Find(source, "ja") ?? source;
+        }
+
+        // In-game text with placeholders, e.g. "コード {0} の段位はありません".
+        public static string InGameFormat(string source, params object[] args) =>
+            string.Format(InGame(source), args);
+
+        // Translates a screen's saved text once it has been bound: only exact table matches change,
+        // so song titles, player names and numbers stay as they are. Typed input values are left
+        // alone; their placeholders are translated.
+        public static void ApplyInGame(Transform root)
+        {
+            if (root == null) return;
+            InGameFont.EnsureDriver();
+            var typed = new HashSet<TMP_Text>();
+            foreach (var field in root.GetComponentsInChildren<TMP_InputField>(true))
+                if (field != null && field.textComponent != null) typed.Add(field.textComponent);
+            // A label with a LocalizedText is already in the selected language from the app's own
+            // string tables; looking its translated text up again would translate it twice.
+            var localized = new HashSet<TMP_Text>();
+            foreach (var label in root.GetComponentsInChildren<LocalizedText>(true))
+                if (label != null && label.TryGetComponent<TMP_Text>(out var managed)) localized.Add(managed);
+            foreach (var text in root.GetComponentsInChildren<TMP_Text>(true))
+            {
+                if (text == null || typed.Contains(text) || localized.Contains(text)) continue;
+                string shown = InGame(text.text);
+                if (!string.Equals(shown, text.text)) text.text = shown;
+                InGameFont.Use(text);
+            }
+        }
+
+        // The language the settings and in-game lookups use right now.
+        public static string Language => CurrentLanguage();
+
+        static string CurrentLanguage() =>
+            SettingManager.Instance != null ? SettingManager.Instance.Settings.general.Language : "en";
+
+        static string Find(string source, string language)
+        {
+            if (!Table.TryGetValue(source, out string[] row)) return null;
+            int index = language switch { "ja" => 0, "zh" => 1, "zh_tw" => 2, _ => -1 };
+            return index < 0 ? null : row[index];
+        }
+    }
+}
