+            var slot = board.Slot;
+            if (slot == null || board.Panel == null) return null;
+            if (slot.Bpm == null)
+            {
+                // The panel is 960 x 164 centred on the slot root and grows upwards while the board
+                // opens, so anchoring to the panel's own bottom-right corner keeps the number in the
+                // corner it belongs to, closed or open.
+                slot.Bpm = BpmReadout.Create(board.Panel.rectTransform, "Bpm", BpmReadout.SongBoardSize,
+                    new Vector2(1, 0), new Vector2(-16, 10));
+            }
+            return slot.Bpm;
         }
 
