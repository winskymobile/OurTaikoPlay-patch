diff --git a/Assets/OurTaiko/Runtime/Scenes/BpmReadout.cs b/Assets/OurTaiko/Runtime/Scenes/BpmReadout.cs
new file mode 100644
index 0000000..d5f08dc
--- /dev/null
+++ b/Assets/OurTaiko/Runtime/Scenes/BpmReadout.cs
@@ -0,0 +1,60 @@
+using System.Globalization;
+using TMPro;
+using UnityEngine;
+
+namespace OurTaiko
+{
+    // A small BPM readout for song select, the course panel and the play HUD. Built at runtime so
+    // no saved layout or serialized field changes: the label is a plain child of the screen it
+    // annotates and is only shown while Settings > Display > Show BPM is on.
+    public static class BpmReadout
+    {
+        public const float SongBoardSize = 26, CourseSize = 28, PlaySize = 30;
+
+        public static bool Enabled =>
+            SettingManager.Instance != null && SettingManager.Instance.Settings.display.ShowBpm;
+
+        // "BPM 180", or one decimal when the chart's tempo is not a whole number.
+        public static string Format(double bpm)
+        {
+            if (double.IsNaN(bpm) || double.IsInfinity(bpm) || bpm <= 0) return "";
+            string number = System.Math.Abs(bpm - System.Math.Round(bpm)) < 0.05
+                ? System.Math.Round(bpm).ToString("0", CultureInfo.InvariantCulture)
+                : bpm.ToString("0.0", CultureInfo.InvariantCulture);
+            return "BPM " + number;
+        }
+
+        // A right-aligned label pinned to one corner of its parent. The anchor makes it follow the
+        // parent when it resizes: an opening song board, the course panel, the play viewport.
+        public static TextMeshProUGUI Create(Transform parent, string name, float size, Vector2 anchor, Vector2 offset)
+        {
+            var label = SkinUi.Text(name, parent, size);
+            var rect = label.rectTransform;
+            rect.anchorMin = rect.anchorMax = anchor;
+            rect.pivot = anchor;
+            rect.sizeDelta = new Vector2(360, size * 1.5f);
+            rect.anchoredPosition = offset;
+            label.alignment = TextAlignmentOptions.BottomRight;
+            label.textWrappingMode = TextWrappingModes.NoWrap;
+            label.overflowMode = TextOverflowModes.Overflow;
+            label.raycastTarget = false;
+            label.color = new Color(1, 1, 1, 0.92f);
+            label.UseUiFont();
+            InGameFont.Use(label);
+            label.text = "";
+            return label;
+        }
+
+        public static void Show(TextMeshProUGUI label, double bpm, bool visible)
+        {
+            if (label == null) return;
+            bool on = visible && Enabled;
+            if (label.gameObject.activeSelf != on) label.gameObject.SetActive(on);
+            if (!on) return;
+            // Only touch the text when the number changes; a per-frame assignment would rebuild
+            // the label's mesh every frame.
+            string text = Format(bpm);
+            if (label.text != text) label.text = text;
+        }
+    }
+}
