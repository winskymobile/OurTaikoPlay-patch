diff --git a/Assets/OurTaiko/Runtime/Play/NoteLaneRenderer.cs b/Assets/OurTaiko/Runtime/Play/NoteLaneRenderer.cs
index d1aa4598..4ab94cb4 100644
--- a/Assets/OurTaiko/Runtime/Play/NoteLaneRenderer.cs
+++ b/Assets/OurTaiko/Runtime/Play/NoteLaneRenderer.cs
@@ -323,11 +323,42 @@ Vector2 Position(ChartNote note, double time)
             var (x, y) = NoteScroll.Distance(note, time, clocks, TravelDistance);
             return new Vector2(judge.x + (float)x, judge.y - (float)y);
         }
+
+        // The skin's note atlases are imported with point sampling. That keeps a hard edge, but at
+        // a canvas scale above 1 (a Retina Mac runs the 1920 design at 1.8x) each texel covers two
+        // or three pixels and the edge crawls while the lane moves. Bilinear trades a little
+        // sharpness for a steady edge; Settings > Display > Smooth Notes picks between them. Read it
+        // every frame so the row applies as soon as a paused play resumes.
+        bool? smoothNotes;
+        void ApplyNoteFilter()
+        {
+            bool smooth = SettingManager.Instance == null || SettingManager.Instance.Settings.display.smoothNotes;
+            if (smoothNotes == smooth) return;
+            smoothNotes = smooth;
+            var mode = smooth ? FilterMode.Bilinear : FilterMode.Point;
+            SetFilter(noteSprites, mode);
+            SetFilter(alternateNoteSprites, mode);
+            SetFilter(rollBodySprites, mode);
+            SetFilter(rollTailSprites, mode);
+            SetFilter(mojiSprites, mode);
+            SetFilter(balloonTailSprite, mode);
+            SetFilter(mojiRollSprite, mode);
+        }
+        static void SetFilter(Sprite[] sprites, FilterMode mode)
+        {
+            if (sprites == null) return;
+            for (int i = 0; i < sprites.Length; i++) SetFilter(sprites[i], mode);
+        }
+        static void SetFilter(Sprite sprite, FilterMode mode)
+        {
+            if (sprite != null && sprite.texture != null) sprite.texture.filterMode = mode;
+        }
         // Draws `session` at `time`. `preview` shows the routes a paused practice would play;
         // `hideSkipped` hides notes the practice attempt skipped. Returns false for an unchanged frame.
         public bool Render(PlaySession session, double time, bool preview, bool hideSkipped)
         {
             Session = session;
+            ApplyNoteFilter();
             // #JPOSSCROLL moves the origin notes are placed from (OpenTaiko GetNoteOriginX/Y).
             var shift = JudgeShift.At(session.Chart.JudgeMoves, time);
             judge = new Vector2(JudgeLocalX + (float)shift.X, JudgeLocalY - (float)shift.Y);
