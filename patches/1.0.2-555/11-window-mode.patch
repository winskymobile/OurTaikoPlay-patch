@@ -198,6 +198,62 @@ public void Apply()
             Application.targetFrameRate = TargetFrameRate;
             // Android gives a game 60 Hz until it asks for more; see DisplayRefreshRate.
             DisplayRefreshRate.Request(Application.platform == RuntimePlatform.Android || targetFrameRate == Unlimited ? 0 : TargetFrameRate);
+            ApplyWindow();
+        }
+
+        // 0: the borderless full-screen window the player ships with. 1: a normal window at
+        // WindowSize, which is what makes the window movable and fit on a shared display.
+        public bool windowed;
+        // All 16:9, so a window fills the 1920x1080 stage exactly and no letterbox bars appear.
+        public static readonly int[] WindowWidths = { 1280, 1600, 1920, 2560 };
+        public static readonly int[] WindowHeights = { 720, 900, 1080, 1440 };
+        public int windowSize = 1;
+        public int WindowSize => Math.Clamp(windowSize, 0, WindowWidths.Length - 1);
+        public int WindowWidth => WindowWidths[WindowSize];
+        public int WindowHeight => WindowHeights[WindowSize];
+
+        // Applied from Apply() (the settings overlay calls it on every change): only when the mode
+        // or the size really changed, so editing another row never snaps back a window the player
+        // has just moved or resized.
+        [NonSerialized] bool windowApplied;
+        [NonSerialized] bool appliedWindowed;
+        [NonSerialized] int appliedWindowSize;
+
+        void ApplyWindow()
+        {
+            if (Application.platform != RuntimePlatform.OSXPlayer && Application.platform != RuntimePlatform.WindowsPlayer
+                && Application.platform != RuntimePlatform.LinuxPlayer) return;
+            if (windowApplied && appliedWindowed == windowed && appliedWindowSize == windowSize) return;
+            windowApplied = true;
+            appliedWindowed = windowed;
+            appliedWindowSize = windowSize;
+            if (windowed)
+            {
+                // Unity resolves in pixels while the rows read as points: on a Retina Mac a
+                // 1600x900 window would otherwise be 800x450 points, half the size the row says.
+                // Twice the size on macOS; a display too small for it gets the largest 16:9 that
+                // fits instead of a window hanging off the screen.
+                int scale = Application.platform == RuntimePlatform.OSXPlayer ? 2 : 1;
+                int width = WindowWidth * scale, height = WindowHeight * scale;
+                // Either source may be points or pixels depending on the platform; the larger
+                // one is the display as the window has to fit on it.
+                var display = Display.main;
+                int screenWidth = Math.Max(Screen.currentResolution.width, display != null ? display.systemWidth : 0);
+                int screenHeight = Math.Max(Screen.currentResolution.height, display != null ? display.systemHeight : 0);
+                if (screenWidth > 0 && screenHeight > 0 && (width > screenWidth || height > screenHeight))
+                {
+                    float fit = Math.Min((float)screenWidth / width, (float)screenHeight / height);
+                    width = Mathf.RoundToInt(width * fit);
+                    height = Mathf.RoundToInt(height * fit);
+                }
+                Screen.SetResolution(width, height, FullScreenMode.Windowed);
+                Log.Info("Display", "window " + width + "x" + height + " (" + WindowWidth + "x" + WindowHeight + " pt)");
+            }
+            else
+            {
+                Screen.SetResolution(Screen.currentResolution.width, Screen.currentResolution.height, FullScreenMode.FullScreenWindow);
+                Log.Info("Display", "full screen " + Screen.currentResolution.width + "x" + Screen.currentResolution.height);
+            }
         }
 
