+        // The pause menu is a fixed prefab: Resume, Restart, the mode switch and Back. The settings
+        // overlay is reachable from Entry, so changing an offset mid-song meant leaving the play.
+        // This appends one more row under Back, in the space the hint line leaves, and moves the
+        // hint under it. Nothing else in the panel moves, so the authored layout keeps its spacing.
+        void AddSettingsButton()
+        {
+            if (buttons == null || buttons.Length == 0) return;
+            var template = buttons[buttons.Length - 1];
+            var row = Instantiate(template, template.transform.parent);
+            row.name = "SettingsButton";
+            // The prefab's labels follow LocalizedText; this row sets its own text in ShowSettingsLabel.
+            foreach (var localized in row.GetComponentsInChildren<LocalizedText>(true)) Destroy(localized);
+            // Instantiate copies the template's wired click (Back to Song Select): start empty.
+            row.onClick = new Button.ButtonClickedEvent();
+            row.onClick.AddListener(OpenSettings);
+            var rect = (RectTransform)row.transform;
+            rect.anchoredPosition = new Vector2(0, -630);
+            rect.sizeDelta = new Vector2(750, 72);
+            settingsButton = row;
+            int index = buttons.Length;
+            System.Array.Resize(ref buttons, index + 1);
+            buttons[index] = row;
+            foreach (var text in GetComponentsInChildren<TMP_Text>(true))
+                if (text.gameObject.name == "Hint")
+                    ((RectTransform)text.transform).anchoredPosition = new Vector2(0, -714);
+            ShowSettingsLabel();
+        }
+
+        void ShowSettingsLabel()
+        {
+            var label = settingsButton != null ? settingsButton.GetComponentInChildren<TMP_Text>(true) : null;
+            if (label == null) return;
+            label.text = UiText.InGame("Game Settings");
+            InGameFont.Use(label);
+        }
+
+        void OpenSettings()
+        {
+            if (SettingsOverlay.IsOpen) return;
+            var overlay = SettingsOverlay.Open();
+            if (overlay != null) overlay.Closed += OnSettingsClosed;
+        }
+
+        // The language can be changed inside the overlay; the pause menu follows it.
+        void OnSettingsClosed()
+        {
+            if (SettingsOverlay.Instance != null) SettingsOverlay.Instance.Closed -= OnSettingsClosed;
+            ApplyLanguage();
         }
 
