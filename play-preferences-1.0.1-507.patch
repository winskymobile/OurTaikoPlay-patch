+++ b/Assets/OurTaiko/Tests/EditMode/FlyingNoteDrawTests.cs
@@ -0,0 +1,42 @@
+using NUnit.Framework;
+
+namespace OurTaiko.Tests
+{
+    public sealed class FlyingNoteDrawTests
+    {
+        [Test]
+        public void MissingAndUnknownValuesStayOnTheCurrentDrawing()
+        {
+            Assert.That(new GameSettings().display.FlyingNoteDraw, Is.EqualTo(DisplaySettings.FlyingCurrent));
+            Assert.That(GameSettings.FromJson("{}").display.FlyingNoteDraw, Is.EqualTo(DisplaySettings.FlyingCurrent));
+            Assert.That(GameSettings.FromJson("{\"display\":{\"flyingNoteDraw\":9}}").display.FlyingNoteDraw,
+                Is.EqualTo(DisplaySettings.FlyingCurrent));
+        }
+
+        [Test]
+        public void FlyingAmountDefaultsToHighAndMediumSkipsDrumrollsOnly()
+        {
+            var display = new DisplaySettings();
+            Assert.That(display.FlyingAmount, Is.EqualTo(DisplaySettings.FlyingHigh));
+            Assert.That(display.Flies(false) && display.Flies(true), Is.True);
+            Assert.That(GameSettings.FromJson("{\"display\":{\"flyingAmount\":9}}").display.FlyingAmount,
+                Is.EqualTo(DisplaySettings.FlyingHigh));
+            display.flyingAmount = DisplaySettings.FlyingMedium;
+            Assert.That(display.Flies(false), Is.True);
+            Assert.That(display.Flies(true), Is.False);
+            display.flyingAmount = DisplaySettings.FlyingLow;
+            Assert.That(display.Flies(false) || display.Flies(true), Is.False);
+        }
+
+        [Test]
+        public void TheChosenDrawingAndAmountSurviveJson()
+        {
+            var settings = new GameSettings();
+            settings.display.flyingNoteDraw = DisplaySettings.FlyingSprite;
+            settings.display.flyingAmount = DisplaySettings.FlyingLow;
+            var loaded = GameSettings.FromJson(settings.ToJson());
+            Assert.That(loaded.display.FlyingNoteDraw, Is.EqualTo(DisplaySettings.FlyingSprite));
+            Assert.That(loaded.display.FlyingAmount, Is.EqualTo(DisplaySettings.FlyingLow));
+        }
+    }
+}
