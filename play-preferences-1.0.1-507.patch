+using System.IO;
+using NUnit.Framework;
+
+namespace OurTaiko.Tests
+{
+    public sealed class GamePathsTests
+    {
+        const string Data = "/Game/OurTaikoPlay.app/Contents";
+        const string Persistent = "/Users/player/Library/Application Support/Other";
+        const string Home = "/Users/player";
+
+        [Test]
+        public void MacStandaloneUsesApplicationSupportAndKeepsSongsUnderIt()
+        {
+            string root = GamePaths.ChooseRoot(false, true, true, Data, Persistent, Home, _ => true);
+            Assert.That(root, Is.EqualTo(Path.GetFullPath(Path.Combine(
+                Home, "Library", "Application Support", "OurTaiko", "OurTaikoPlay"))));
+            Assert.That(GamePaths.SongsDirectory(root), Is.EqualTo(Path.Combine(root, "Songs")));
+            Assert.That(GamePaths.ChooseRoot(false, true, true, Data, Persistent, Home, _ => false), Is.EqualTo(root));
+        }
+
+        [Test]
+        public void WindowsAndLinuxStayBesideTheExecutableWhenItIsWritable()
+        {
+            string beside = Path.GetFullPath(Path.Combine(Data, ".."));
+            Assert.That(GamePaths.ChooseRoot(false, true, false, Data, Persistent, Home, _ => true), Is.EqualTo(beside));
+            Assert.That(GamePaths.ChooseRoot(false, true, false, Data, Persistent, Home, _ => false), Is.EqualTo(Persistent));
+        }
+
+        [Test]
+        public void EditorAndMobileKeepThePersistentPath()
+        {
+            Assert.That(GamePaths.ChooseRoot(true, true, true, Data, Persistent, Home, _ => true), Is.EqualTo(Persistent));
+            Assert.That(GamePaths.ChooseRoot(false, false, false, Data, Persistent, Home, _ => true), Is.EqualTo(Persistent));
+        }
+    }
+}
