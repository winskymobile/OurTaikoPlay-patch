diff --git a/Assets/OurTaiko/Runtime/Scenes/DanExamArt.cs b/Assets/OurTaiko/Runtime/Scenes/DanExamArt.cs
new file mode 100644
index 0000000..f1b01a9
--- /dev/null
+++ b/Assets/OurTaiko/Runtime/Scenes/DanExamArt.cs
@@ -0,0 +1,53 @@
+using System.Collections.Generic;
+using System.IO;
+using UnityEngine;
+
+namespace OurTaiko
+{
+    // The 段位道場 exam conditions are painted into sprites, so the translation table cannot reach
+    // them: the eight condition labels, the 合格条件 tab and the in-play panel's own label set. The
+    // patch build embeds Simplified and Traditional copies (tools/make-dan-exam-art.py); Japanese,
+    // and English which shows Japanese in game, keep the sprites shipped with the app.
+    static class DanExamArt
+    {
+        const string Prefix = "OurTaiko.Art.";
+        // DanExamType order.
+        static readonly string[] Names = { "gauge", "judgeperfect", "judgegood", "judgebad", "hit", "score", "combo", "roll" };
+        static readonly Dictionary<string, Sprite> Cache = new Dictionary<string, Sprite>();
+        static bool missing;
+
+        // A condition's label; inGame picks the smaller set the play scene draws.
+        public static Sprite Label(int type, bool inGame = false)
+        {
+            if (type < 0 || type >= Names.Length) return null;
+            return Load((inGame ? "exam_play_" : "exam_") + Names[type]);
+        }
+
+        // The 合格条件 tab above the conditions.
+        public static Sprite Header() => Load("exam_header");
+
+        // The confirmation popup: "text" (the question), "yes", "no".
+        public static Sprite Confirm(string part) => Load("confirm_" + part);
+
+        static Sprite Load(string name)
+        {
+            string language = UiText.InGameLanguage(UiText.Language);
+            if (language != "zh" && language != "zh_tw") return null;
+            if (missing) return null;
+            string key = name + ":" + language;
+            if (Cache.TryGetValue(key, out var cached)) return cached;
+            using var stream = typeof(DanExamArt).Assembly.GetManifestResourceStream(Prefix + name + "." + language + ".png");
+            if (stream == null) { missing = true; return null; }
+            using var memory = new MemoryStream();
+            stream.CopyTo(memory);
+            var texture = new Texture2D(2, 2, TextureFormat.RGBA32, false);
+            if (!texture.LoadImage(memory.ToArray())) { missing = true; return null; }
+            texture.wrapMode = TextureWrapMode.Clamp;
+            texture.filterMode = FilterMode.Bilinear;
+            var sprite = Sprite.Create(texture, new Rect(0, 0, texture.width, texture.height), new Vector2(0.5f, 0.5f), 100f, 0, SpriteMeshType.FullRect);
+            sprite.name = name;
+            Cache[key] = sprite;
+            return sprite;
+        }
+    }
+}
