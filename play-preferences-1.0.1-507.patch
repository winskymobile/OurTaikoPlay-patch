diff --git a/Assets/OurTaiko/Runtime/Core/MacPlayerData.cs b/Assets/OurTaiko/Runtime/Core/MacPlayerData.cs
new file mode 100644
index 0000000..09b54d9
--- /dev/null
+++ b/Assets/OurTaiko/Runtime/Core/MacPlayerData.cs
@@ -0,0 +1,55 @@
+using System;
+using System.IO;
+using UnityEngine;
+
+namespace OurTaiko
+{
+    // Copies player files out of a macOS .app bundle root. The bundle root also holds Contents
+    // and the executable, so only the named entries move, and nothing is deleted.
+    public static class MacPlayerData
+    {
+        public static readonly string[] Files = {
+            "settings.json", "options.json", "player.json", "servers.json", "scores.sqlite3",
+        };
+        public static readonly string[] Folders = { "Songs", "cache" };
+
+        public static void CopyMissing(string sourceRoot, string destinationRoot)
+        {
+            try
+            {
+                if (string.IsNullOrEmpty(sourceRoot) || string.IsNullOrEmpty(destinationRoot)) return;
+                sourceRoot = Path.GetFullPath(sourceRoot);
+                destinationRoot = Path.GetFullPath(destinationRoot);
+                if (string.Equals(sourceRoot, destinationRoot, StringComparison.Ordinal)) return;
+                Directory.CreateDirectory(destinationRoot);
+                foreach (string folder in Folders) CopyFolder(Path.Combine(sourceRoot, folder), Path.Combine(destinationRoot, folder));
+                foreach (string file in Files) CopyFile(Path.Combine(sourceRoot, file), Path.Combine(destinationRoot, file));
+            }
+            catch (Exception error) { Debug.LogWarning("Could not copy player data: " + error.Message); }
+        }
+
+        static void CopyFile(string source, string destination)
+        {
+            if (!File.Exists(source)) return;
+            if (File.Exists(destination) && new FileInfo(destination).Length > 0) return;
+            Directory.CreateDirectory(Path.GetDirectoryName(destination));
+            File.Copy(source, destination, true);
+        }
+
+        // An empty Songs directory still counts as missing, so a later launch can fill it.
+        static void CopyFolder(string source, string destination)
+        {
+            if (!Directory.Exists(source)) return;
+            if (Directory.Exists(destination) && Directory.GetFileSystemEntries(destination).Length > 0) return;
+            Directory.CreateDirectory(destination);
+            foreach (string file in Directory.GetFiles(source, "*", SearchOption.AllDirectories))
+            {
+                string relative = Path.GetRelativePath(source, file);
+                string target = Path.Combine(destination, relative);
+                Directory.CreateDirectory(Path.GetDirectoryName(target));
+                if (File.Exists(target) && new FileInfo(target).Length > 0) continue;
+                File.Copy(file, target, true);
+            }
+        }
+    }
+}
