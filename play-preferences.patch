+using NUnit.Framework;
+
+namespace OurTaiko.Tests
+{
+    public sealed class UiTextTests
+    {
+        const string Chart = "TITLE:Base title\nTITLEEN:English title\nTITLEJA:日本語の曲名\nBPM:120\nCOURSE:Oni\nLEVEL:1\n#START\n1000,\n#END";
+
+        [Test]
+        public void SettingsUseTheSelectedLanguageAndFallBackToEnglish()
+        {
+            Assert.That(UiText.Settings("Language", "zh"), Is.EqualTo("语言"));
+            Assert.That(UiText.Settings("Language", "ko"), Is.EqualTo("언어"));
+            Assert.That(UiText.Settings("Language", "en"), Is.EqualTo("Language"));
+            Assert.That(UiText.Settings("Not in the table", "zh"), Is.EqualTo("Not in the table"));
+        }
+
+        [Test]
+        public void SettingsHeadingAndEntryBoardsFollowTheLanguage()
+        {
+            Assert.That(UiText.InGame("ゲーム設定", "zh"), Is.EqualTo("游戏设置"));
+            Assert.That(UiText.InGame("ゲーム設定", "zh_tw"), Is.EqualTo("遊戲設定"));
+            Assert.That(UiText.InGame("ゲーム設定", "ja"), Is.EqualTo("ゲーム設定"));
+            Assert.That(UiText.InGame("演奏ゲーム", "zh"), Is.EqualTo("演奏游戏"));
+            Assert.That(UiText.InGame("段位道場", "zh"), Is.EqualTo("段位道场"));
+        }
+
+        [Test]
+        public void InGameUsesJapaneseForEnglishAndKoreanAndKeepsSongTitlesSeparate()
+        {
+            Assert.That(UiText.InGameLanguage("en"), Is.EqualTo("ja"));
+            Assert.That(UiText.InGameLanguage("ko"), Is.EqualTo("ja"));
+            Assert.That(UiText.InGame("返回选曲", "zh_tw"), Is.EqualTo("返回選曲"));
+            Assert.That(UiText.InGame("返回选曲", "en"), Is.EqualTo("曲選択にもどる"));
+            Assert.That(UiText.InGame("返回选曲", "zh"), Is.EqualTo("返回选曲"));
+            Assert.That(UiText.InGame("Missing sentence", "zh"), Is.EqualTo("Missing sentence"));
+            Assert.That(SongInfo.Read(Chart, "en").Title, Is.EqualTo("English title"));
+            Assert.That(UiText.InGame("Resume", "en"), Is.EqualTo("再開"));
+        }
+    }
+}
