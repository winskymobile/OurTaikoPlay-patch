+using System.Collections;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace OurTaiko.Tests
+{
+    public sealed class NoteArcDrawModeTests
+    {
+        [UnityTest]
+        public IEnumerator SpriteModeDrawsFlyingNotesWithoutInterfaceImages()
+        {
+            var manager = SettingManager.EnsureInstance();
+            var previous = manager.Settings.Clone();
+            var sprite = Sprite.Create(Texture2D.whiteTexture, new Rect(0, 0, 4, 4), new Vector2(0.5f, 0.5f), 100);
+            sprite.name = "ArcNote";
+            NoteArcView arcs = null;
+            try
+            {
+                var settings = previous.Clone();
+                settings.display.flyingNoteDraw = DisplaySettings.FlyingSprite;
+                manager.UseUnsaved(settings);
+                var host = new GameObject("Arcs", typeof(RectTransform));
+                arcs = host.AddComponent<NoteArcView>();
+                arcs.lane = (RectTransform)host.transform;
+                arcs.Spawn(sprite, false, 0);
+                arcs.Spawn(sprite, true, 0.01);
+                Assert.That(arcs.ActiveCount, Is.EqualTo(2));
+                for (int i = 0; i < arcs.ActiveCount; i++)
+                {
+                    Assert.That(arcs.ArcRoot(i).GetComponent<UnityEngine.UI.Image>(), Is.Null);
+                    Assert.That(arcs.ArcRoot(i).GetComponentInChildren<SpriteRenderer>(), Is.Not.Null);
+                    Assert.That(arcs.ArcRoot(i).GetComponent<LaneSprite>().sprite, Is.EqualTo(sprite));
+                }
+                settings.display.flyingNoteDraw = DisplaySettings.FlyingCurrent;
+                manager.UseUnsaved(settings);
+                arcs.Spawn(sprite, false, 0.02);
+                Assert.That(arcs.ArcRoot(2).GetComponent<UnityEngine.UI.Image>(), Is.Not.Null);
+                Assert.That(arcs.ArcRoot(2).GetComponent<UnityEngine.UI.Image>().sprite, Is.EqualTo(sprite));
+                yield return null;
+            }
+            finally
+            {
+                manager.UseUnsaved(previous);
+                if (arcs != null) Object.Destroy(arcs.gameObject);
+                Object.Destroy(sprite);
+            }
+        }
+    }
+}
