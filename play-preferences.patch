diff --git a/Assets/OurTaiko/Runtime/Scenes/ResultArt.cs b/Assets/OurTaiko/Runtime/Scenes/ResultArt.cs
new file mode 100644
index 0000000..2d0857d
--- /dev/null
+++ b/Assets/OurTaiko/Runtime/Scenes/ResultArt.cs
@@ -0,0 +1,89 @@
+using System.Collections.Generic;
+using System.IO;
+using UnityEngine;
+
+namespace OurTaiko
+{
+    // The result board's difficulty tabs and judge labels are painted into two sprites, so the
+    // translation table cannot reach them. The patch build embeds Simplified and Traditional copies
+    // of those sprites (tools/make-result-art.py); Japanese, and English/Korean which show Japanese
+    // in game, keep the sprites shipped with the app.
+    static class ResultArt
+    {
+        const string Prefix = "OurTaiko.Art.";
+        static readonly Dictionary<string, Sprite> Cache = new Dictionary<string, Sprite>();
+        static readonly Dictionary<string, Texture2D> Textures = new Dictionary<string, Texture2D>();
+        static bool missing;
+
+        public static Sprite Difficulty(int index)
+        {
+            var texture = Sheet("difficulty");
+            if (texture == null) return null;
+            index = Mathf.Clamp(index, 0, 4);
+            string key = "difficulty:" + UiText.InGameLanguage(UiText.Language) + ":" + index;
+            if (Cache.TryGetValue(key, out var cached)) return cached;
+            var rect = new Rect(index * 320, 0, 320, 96);
+            var sprite = Sprite.Create(texture, rect, new Vector2(0.5f, 0.5f), 100f, 0, SpriteMeshType.FullRect);
+            sprite.name = "ResultDifficulty" + index;
+            Cache[key] = sprite;
+            return sprite;
+        }
+
+        public static Sprite Score() => Whole("score", new Rect(0, 0, 420, 48));
+
+        // clear_ja.png is a 120x40 sheet whose クリア sprite sits at (0, 4) and is 64x31.
+        public static Sprite Clear(bool dark) =>
+            Whole(dark ? "clear_dark" : "clear", new Rect(0, 4, 64, 31));
+
+        static Sprite Whole(string name, Rect rect)
+        {
+            var texture = Sheet(name);
+            if (texture == null) return null;
+            string key = name + ":" + UiText.InGameLanguage(UiText.Language);
+            if (Cache.TryGetValue(key, out var cached)) return cached;
+            var sprite = Sprite.Create(texture, rect, new Vector2(0.5f, 0.5f), 100f, 0, SpriteMeshType.FullRect);
+            sprite.name = "Result" + name;
+            Cache[key] = sprite;
+            return sprite;
+        }
+
+        public static Sprite JudgeLabels()
+        {
+            var texture = Sheet("judge");
+            if (texture == null) return null;
+            string key = "judge:" + UiText.InGameLanguage(UiText.Language);
+            if (Cache.TryGetValue(key, out var cached)) return cached;
+            var rect = new Rect(0, 0, texture.width, texture.height);
+            var sprite = Sprite.Create(texture, rect, new Vector2(0.5f, 0.5f), 100f, 0, SpriteMeshType.FullRect);
+            sprite.name = "ResultJudgeLabels";
+            Cache[key] = sprite;
+            return sprite;
+        }
+
+        static Texture2D Sheet(string name)
+        {
+            string language = UiText.InGameLanguage(UiText.Language);
+            if (language != "zh" && language != "zh_tw") return null;
+            if (missing) return null;
+            string key = name + ":" + language;
+            if (Textures.TryGetValue(key, out var cached)) return cached;
+            var texture = Read(name + "." + language);
+            if (texture == null) { missing = true; return null; }
+            Textures[key] = texture;
+            return texture;
+        }
+
+        static Texture2D Read(string file)
+        {
+            using var stream = typeof(ResultArt).Assembly.GetManifestResourceStream(Prefix + file + ".png");
+            if (stream == null) return null;
+            using var memory = new MemoryStream();
+            stream.CopyTo(memory);
+            var texture = new Texture2D(2, 2, TextureFormat.RGBA32, false);
+            if (!texture.LoadImage(memory.ToArray())) return null;
+            texture.wrapMode = TextureWrapMode.Clamp;
+            texture.filterMode = FilterMode.Bilinear;
+            return texture;
+        }
+    }
+}
