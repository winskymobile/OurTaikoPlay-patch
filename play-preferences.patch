+            string id = System.Guid.NewGuid().ToString("N");
+            source = Path.Combine(UnityEngine.Application.temporaryCachePath, "mac-src-" + id);
+            destination = Path.Combine(UnityEngine.Application.temporaryCachePath, "mac-dst-" + id);
+            Directory.CreateDirectory(Path.Combine(source, "Contents", "MacOS"));
+            File.WriteAllText(Path.Combine(source, "Contents", "Info.plist"), "bundle");
+            File.WriteAllBytes(Path.Combine(source, "Contents", "MacOS", "OurTaikoPlay"), new byte[] { 1, 2, 3 });
+        }
+
+        [TearDown]
+        public void TearDown()
+        {
+            if (Directory.Exists(source)) Directory.Delete(source, true);
+            if (Directory.Exists(destination)) Directory.Delete(destination, true);
+        }
+
+        [Test]
+        public void CopiesSongsIntoAnEmptyDestinationAndLeavesTheAppBundle()
+        {
+            Directory.CreateDirectory(Path.Combine(source, "Songs", "Pack"));
+            File.WriteAllText(Path.Combine(source, "Songs", "Pack", "song.tja"), "TITLE:One");
+            File.WriteAllText(Path.Combine(source, "settings.json"), "{\"general\":{}}");
+            Directory.CreateDirectory(destination);
+            MacPlayerData.CopyMissing(source, destination);
+
+            Assert.That(File.ReadAllText(Path.Combine(destination, "Songs", "Pack", "song.tja")), Is.EqualTo("TITLE:One"));
+            Assert.That(File.ReadAllText(Path.Combine(destination, "settings.json")), Is.EqualTo("{\"general\":{}}"));
+            Assert.That(File.ReadAllText(Path.Combine(source, "Songs", "Pack", "song.tja")), Is.EqualTo("TITLE:One"));
+            Assert.That(Directory.Exists(Path.Combine(destination, "Contents")), Is.False);
+            Assert.That(File.Exists(Path.Combine(destination, "OurTaikoPlay")), Is.False);
+        }
+
+        [Test]
+        public void FillsAnEmptySongsDirectory()
+        {
+            Directory.CreateDirectory(Path.Combine(source, "Songs"));
+            File.WriteAllText(Path.Combine(source, "Songs", "a.tja"), "chart");
+            Directory.CreateDirectory(Path.Combine(destination, "Songs"));
+            MacPlayerData.CopyMissing(source, destination);
+            Assert.That(File.ReadAllText(Path.Combine(destination, "Songs", "a.tja")), Is.EqualTo("chart"));
+        }
+
+        [Test]
+        public void DoesNotOverwriteANonEmptyDestination()
+        {
+            File.WriteAllText(Path.Combine(source, "settings.json"), "old");
+            Directory.CreateDirectory(Path.Combine(source, "Songs"));
+            File.WriteAllText(Path.Combine(source, "Songs", "a.tja"), "old chart");
+            Directory.CreateDirectory(Path.Combine(destination, "Songs"));
+            File.WriteAllText(Path.Combine(destination, "Songs", "kept.tja"), "kept");
+            File.WriteAllText(Path.Combine(destination, "settings.json"), "kept settings");
+            MacPlayerData.CopyMissing(source, destination);
+            Assert.That(File.ReadAllText(Path.Combine(destination, "settings.json")), Is.EqualTo("kept settings"));
+            Assert.That(Directory.GetFiles(Path.Combine(destination, "Songs")).Select(Path.GetFileName), Is.EqualTo(new[] { "kept.tja" }));
+        }
+
+        [Test]
+        public void ACopyFailureDoesNotThrow()
+        {
+            Directory.CreateDirectory(Path.Combine(source, "Songs"));
+            File.WriteAllText(Path.Combine(source, "Songs", "a.tja"), "chart");
+            Assert.DoesNotThrow(() => MacPlayerData.CopyMissing(source, Path.Combine(destination, "\0bad")));
+            Assert.That(File.Exists(Path.Combine(source, "Songs", "a.tja")), Is.True);
+        }
+    }
+}
