+using System.Collections;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace OurTaiko.Tests
+{
+    public sealed class ResultLanguageFlowTests
+    {
+        [UnityTest]
+        public IEnumerator TraditionalChineseReplacesTheHardcodedResultLabel()
+        {
+            var manager = SettingManager.EnsureInstance();
+            var previous = manager.Settings.Clone();
+            GameObject host = null;
+            try
+            {
+                var settings = previous.Clone();
+                settings.general.language = "zh_tw";
+                manager.UseUnsaved(settings);
+                host = new GameObject("ResultLanguage", typeof(Canvas));
+                var labelObject = new GameObject("Action", typeof(RectTransform));
+                labelObject.transform.SetParent(host.transform, false);
+                var label = labelObject.AddComponent<TMPro.TextMeshProUGUI>();
+                var view = host.AddComponent<ResultAnalysisView>();
+                view.actionLabel = label;
+                view.SetReady(true);
+                Assert.That(label.text, Is.EqualTo("返回選曲"));
+                settings.general.language = "en";
+                manager.UseUnsaved(settings);
+                view.SetReady(true);
+                Assert.That(label.text, Is.EqualTo("曲選択にもどる"));
+                Assert.That(SongInfo.Read("TITLE:English title\nTITLEJA:日本語\nBPM:120\nCOURSE:Oni\nLEVEL:1\n#START\n1000,\n#END", "en").Title,
+                    Is.EqualTo("English title"));
+                yield return null;
+            }
+            finally
+            {
+                manager.UseUnsaved(previous);
+                if (host != null) Object.Destroy(host);
+            }
+        }
+    }
+}
